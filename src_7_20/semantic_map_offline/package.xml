  <version>0.1.0</version>
  <description>Offline RGB-D projection and semantic object tracking.</description>
  <maintainer email="1074793744@qq.com">weiyu</maintainer>
  <license>Apache-2.0</license>
  <depend>ament_index_python</depend>
  <depend>cartographer_ros_msgs</depend>
  <depend>rosbag2_py</depend>
  <depend>rosidl_runtime_py</depend>
  <depend>tf2_msgs</depend>

  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>
  <depend>python3-yaml</depend>
  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
